# Supabase (projet "maison-fade", eu-west-2) — remplacer [PASSWORD] par le mot
# de passe de la base (Project Settings > Database > Database password sur
# supabase.com/dashboard/project/wihtbwdhtlgnuolpaafk).
# Port 5432 (mode "session" du pooler Supavisor) plutôt que 6543 (mode
# "transaction", pgbouncer=true) : NestJS est un serveur long-lived avec peu
# de connexions simultanées — le mode session lui convient mieux, et le mode
# transaction s'est montré instable en dev (pool serveur limité sur le plan
# gratuit, épuisé par les redémarrages répétés). connect_timeout=30 reste
# nécessaire : le pooler répond parfois plus lentement que le défaut Prisma (5s).
# connection_limit=20 explicite : sans lui, Prisma déduit sa taille de pool du
# nombre de coeurs CPU locaux (souvent 5 en dev) — trop bas pour la salve de
# requêtes parallèles émise juste après une connexion (catalogue, clients,
# coiffeurs, agenda, stock, identité du salon, équipe, statistiques) ;
# provoquait des « Timed out fetching a new connection from the connection
# pool » (P2024) au login. Relevé de 10 à 20 avec l'ajout des écrans
# Personnel/Supervision 360° (plusieurs endpoints supplémentaires interrogés
# à la navigation) — à ajuster selon le plan Supabase réellement utilisé en
# production.
DATABASE_URL="postgresql://postgres.wihtbwdhtlgnuolpaafk:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?connect_timeout=30&connection_limit=20&pool_timeout=30"
DIRECT_URL="postgresql://postgres.wihtbwdhtlgnuolpaafk:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?connect_timeout=30"

PORT=3000

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"

# Verrouillage du compte après échecs de connexion (CDC 4.1)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=5

# UnitechPay (Wave + Max It uniquement — Free Money non couvert). Aucun mode
# sandbox : toute création d'intention touche l'API de production.
UNITECHPAY_API_KEY="[CLE_API_UNITECHPAY]"
UNITECHPAY_BASE_URL="https://api.unitech.sn/api"
# Optionnels — URLs de retour après paiement (front pas encore branché en V1)
UNITECHPAY_CALLBACK_SUCCESS=
UNITECHPAY_CALLBACK_CANCEL=

# Alertes Telegram à Bamba (CDC §8 — écart de clôture, paiement échoué/expiré).
# Facultatif : sans ces deux valeurs, les alertes sont silencieusement
# ignorées (aucune erreur, le reste de l'app fonctionne normalement).
# 1. Créer un bot via @BotFather sur Telegram (commande /newtoken) -> jeton.
# 2. Démarrer une conversation avec ce bot, puis appeler
#    https://api.telegram.org/bot<TOKEN>/getUpdates pour lire le chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
